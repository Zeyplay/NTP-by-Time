# ==============================================================================
# Файл исключения контекста сборки Docker
# @file .dockerignore
# @brief Исключает служебные и временные файлы из контекста сборки
# @author ZeyPlay ( zeyplay@university.com )
# @date 2026-06-05
# @version 1.0.0
# @license GNU GPLv3 <https://gnu.org>
# ==============================================================================

# Служебные директории Git и CI/CD
.git
.github

# Академическая документация и отчеты
thesis/
docs/
*.md
LICENSE.txt

# Секреты и локальные конфигурации
.env
*.pem
*.key
*.pub

# Кэш линтеров, виртуальные среды и тесты
.venv
venv
__pycache__
.pytest_cache
deploy/scripts/tests

# Архивы сборки
*.zip
*.tar.gz
*.tgz

# Временные файлы ОС
.DS_Store
Thumbs.db

# Логи
*.log
logs/
